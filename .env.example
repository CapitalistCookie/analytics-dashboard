# Analytics Dashboard Environment Configuration
# Copy to .env and update with your values

# ============================================
# DATABASE
# ============================================
SQLITE_DATABASE_URL=sqlite:///./data/analytics.db

# ============================================
# INFLUXDB (Time-series metrics)
# ============================================
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
INFLUXDB_ORG=frigate
INFLUXDB_BUCKET=analytics
INFLUXDB_TOKEN=CHANGE_ME_GENERATE_WITH_influx_auth_create

# ============================================
# MQTT (Event messaging)
# ============================================
MQTT_HOST=mosquitto
MQTT_PORT=1883

# ============================================
# FRIGATE (NVR)
# ============================================
FRIGATE_URL=http://frigate:5000
RTSP_PASSWORD=

# ============================================
# CAMERA CREDENTIALS
# Update for your specific cameras
# ============================================
# Hikvision cameras
HIKVISION_USER=admin
HIKVISION_PASSWORD=CHANGE_ME

# CamHi cameras (237, 238, 239)
CAMHI_USER=admin
CAMHI_PASSWORD=CHANGE_ME

# ============================================
# AUTHENTICATION
# ============================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHAR_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================
# REID (Person Re-identification)
# ============================================
REID_SIMILARITY_THRESHOLD=0.80
REID_CROSS_CAMERA_THRESHOLD=0.75
REID_MIN_MATCH_EMBEDDINGS=2
REID_EMBEDDINGS_PER_PERSON=5
REID_MIN_DETECTION_AREA=2000

# ============================================
# GPU SETTINGS
# ============================================
# Options: cuda, cpu
DETECTOR_DEVICE=cuda
